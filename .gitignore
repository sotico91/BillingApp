# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders (regenerate with `npx expo prebuild`)
# Keep ios/ tracked for device Release installs; android/ is generated locally or via EAS.
/android

# local IDE
.cursor/
.claude/

# iOS native (track project, ignore deps/build)
ios/Pods/
ios/build/
ios/DerivedData/
*.xcuserstate
xcuserdata/

# Android local build outputs (if android/ is generated)
android/app/build/
android/.gradle/
android/build/
*.apk
*.aab
